# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ambassador_es"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"

# Reddit API
REDDIT_CLIENT_ID="your-client-id"
REDDIT_CLIENT_SECRET="your-secret"
REDDIT_USER_AGENT="TaxDownAmbassador/1.0"

# Email (SendGrid or similar)
SENDGRID_API_KEY="your-sendgrid-key"
SENDGRID_FROM_EMAIL="noreply@taxdown.es"

# Payment (Stripe)
STRIPE_SECRET_KEY="your-stripe-key"

# Security
CRON_SECRET="your-cron-secret-for-reddit-sync"
ENCRYPTION_KEY="your-encryption-key-for-iban"

# Admin
ADMIN_EMAIL="admin@taxdown.es"
